{
  "name": "@zylem/shaders",
  "version": "0.1.3",
  "type": "module",
  "description": "WebGPU-compatible TSL shaders and postprocessing effects for the Zylem game framework.",
  "license": "MIT",
  "author": "Tim Cool",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zylem-game-lib/shaders.git"
  },
  "homepage": "https://github.com/zylem-game-lib/shaders#readme",
  "bugs": {
    "url": "https://github.com/zylem-game-lib/shaders/issues"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10.32.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postprocessing": {
      "types": "./dist/postprocessing.d.ts",
      "import": "./dist/postprocessing.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "NODE_ENV=production tsup",
    "dev": "tsup --watch",
    "lint": "biome check src",
    "typecheck": "tsgo --noEmit",
    "showcase:dev": "pnpm --filter @zylem/shader-showcase dev",
    "showcase:build": "pnpm --filter @zylem/shader-showcase build",
    "showcase:preview": "pnpm --filter @zylem/shader-showcase preview"
  },
  "peerDependencies": {
    "three": "^0.185.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.7",
    "@types/three": "^0.185.0",
    "@typescript/native-preview": "latest",
    "three": "^0.185.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@types/tsl-textures": "^3.0.0",
    "tsl-textures": "^3.0.4"
  },
  "packageManager": "pnpm@10.33.0"
}
